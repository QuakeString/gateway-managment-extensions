{
  "name": "gateway-management-extension",
  "private": true,
  "version": "4.1.0",
  "description": "ThingsBoard Gateway Management Extension",
  "scripts": {
    "ng": "ng",
    "start": "yarn run build:scss && node ./node_modules/@angular/cli/bin/ng serve",
    "build": "yarn run build:scss && node ./node_modules/@angular/cli/bin/ng build && node bundle.js && node install.js",
    "build:scss": "npx postcss ./src/app/scss/style.scss -o ./src/app/scss/style.comp.scss",
    "prepare": "patch-package",
    "lint": "ng lint",
    "license-check": "license-check-and-add check -f .license-check.json",
    "license-add": "license-check-and-add add -f .license-check.json",
    "license-remove": "license-check-and-add remove -f .license-check.json"
  },
  "engines": {
    "node": ">=18.19.1",
    "yarn": ">=1.22.22 <2",
    "npm": "Please use yarn instead of NPM to install dependencies"
  },
  "dependencies": {
    "echarts": "https://github.com/QuakeString/echarts/archive/5.5.1-TB.tar.gz",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.6",
    "@angular-devkit/core": "22.2.6",
    "@angular-devkit/schematics": "22.2.6",
    "@angular-eslint/builder": "18.3.1",
    "@angular-eslint/eslint-plugin": "18.3.1",
    "@angular-eslint/eslint-plugin-template": "18.3.1",
    "@angular-eslint/schematics": "18.3.1",
    "@angular-eslint/template-parser": "18.3.1",
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.7",
    "@angular/cli": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "22.2.6",
    "@angular/language-service": "22.2.6",
    "@angular/material": "22.2.7",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@ngrx/store": "22.0.1",
    "@ngx-translate/core": "^15.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@tb/custom-builder": "file:./builders",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@typescript-eslint/utils": "^8.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "~8.57.1",
    "eslint-plugin-import": "latest",
    "eslint-plugin-jsdoc": "latest",
    "eslint-plugin-prefer-arrow": "latest",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "license-check-and-add": "^4.0.5",
    "ng-packagr": "22.2.6",
    "ngrx-store-freeze": "^0.2.4",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.0.0",
    "postinstall-prepare": "^2.0.0",
    "prettier": "^2.8.3",
    "rollup": "^4.24.0",
    "rxjs": "~7.8.1",
    "sentient-ui-types": "https://github.com/QuakeString/sentient-ui-types.git#4.4.0.1",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tslib": "^2.7.0",
    "typescript": "~6.0.2",
    "zone.js": "~0.15.1"
  },
  "resolutions": {
    "zrender": "https://github.com/QuakeString/zrender/archive/5.5.0-TB.tar.gz"
  }
}
